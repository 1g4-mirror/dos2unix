"OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN\n"
"IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n"
msgstr ""
"AUTORS ŠO PROGRAMMATŪRU NODROŠINA „TĀDU, KĀDA TĀ IR”, UN JEBKĀDAS\n"
"TIEŠAS VAI NETIEŠAS GARANTIJAS, TOSTARP, BET NE TIKAI, NETIEŠĀS\n"
"GARANTIJAS PAR PĀRDODAMĪBU UN PIEMĒROTĪBU KONKRĒTAM MĒRĶIM, TIEK\n"
"NOLIEGTAS.  AUTORS NEKĀDĀ GADĪJUMĀ NEATBILD PAR JEBKĀDIEM TIEŠIEM,\n"
"NETIEŠIEM, NEJAUŠIEM, ĪPAŠIEM, SODA VAI IZRIETOŠIEM ZAUDĒJUMIEM\n"
"(TOSTARP, BET NE TIKAI, AIZSTĀJĒJPRECU VAI PAKALPOJUMU IEGĀDI;\n"
"LIETOJUMA, DATU VAI PEĻŅAS ZAUDĒJUMU; VAI DARBĪBAS PĀRTRAUKUMU),\n"
"KAS RADUŠIES JEBKĀDĀ VEIDĀ UN SASKAŅĀ AR JEBKURU ATBILDĪBAS TEORIJU —\n"
"LĪGUMA, STINGRAS ATBILDĪBAS VAI CIVILTIESISKA PĀRKĀPUMA (TOSTARP\n"
"NOLAIDĪBAS VAI CITĀDI) DĒĻ, KAS JEBKĀDĀ VEIDĀ IZRIET NO ŠĪS\n"
"PROGRAMMATŪRAS LIETOŠANAS, PAT JA PAR ŠĀDU ZAUDĒJUMU IESPĒJAMĪBU\n"
"BIJA BRĪDINĀTS.\n"

#: common.c:689
#, c-format
msgid "Usage: %s [options] [file ...] [-n infile outfile ...]\n"
msgstr "Lietošana: %s [opcijas] [fails ...] [-n ievades_fails izvades_fails ...]\n"

#: common.c:691
msgid " --allow-chown         allow file ownership change\n"
msgstr " --allow-chown         atļaut mainīt faila īpašnieku\n"

#: common.c:693
msgid " -ascii                default conversion mode\n"
msgstr " -ascii                noklusējuma pārveides režīms\n"

#: common.c:694
msgid " -iso                  conversion between DOS and ISO-8859-1 character set\n"
msgstr " -iso                  pārveide starp DOS un ISO-8859-1 rakstzīmju kopu\n"

#: common.c:695
msgid "   -1252               use Windows code page 1252 (Western European)\n"
msgstr "   -1252               izmantot Windows kodu lappusi 1252 (Rietumeiropas)\n"

#: common.c:696
msgid "   -437                use DOS code page 437 (US) (default)\n"
msgstr "   -437                izmantot DOS kodu lappusi 437 (ASV) (noklusējums)\n"

#: common.c:697
msgid "   -850                use DOS code page 850 (Western European)\n"
msgstr "   -850                izmantot DOS kodu lappusi 850 (Rietumeiropas)\n"

#: common.c:698
msgid "   -860                use DOS code page 860 (Portuguese)\n"
msgstr "   -860                izmantot DOS kodu lappusi 860 (portugāļu)\n"

#: common.c:699
msgid "   -863                use DOS code page 863 (French Canadian)\n"
msgstr "   -863                izmantot DOS kodu lappusi 863 (Kanādas franču)\n"

#: common.c:700
msgid "   -865                use DOS code page 865 (Nordic)\n"
msgstr "   -865                izmantot DOS kodu lappusi 865 (Ziemeļvalstu)\n"

#: common.c:701
msgid " -7                    convert 8 bit characters to 7 bit space\n"
msgstr " -7                    pārveidot 8 bitu rakstzīmes uz 7 bitu telpu\n"

#: common.c:703
msgid " -b, --keep-bom        keep Byte Order Mark\n"
msgstr " -b, --keep-bom        paturēt baitu secības zīmi (BOM)\n"

#: common.c:705
msgid " -b, --keep-bom        keep Byte Order Mark (default)\n"
msgstr " -b, --keep-bom        paturēt baitu secības zīmi (BOM) (noklusējums)\n"

#: common.c:706
msgid ""
" -c, --convmode        conversion mode\n"
"   convmode            ascii, 7bit, iso, mac, default to ascii\n"
msgstr ""
" -c, --convmode        pārveides režīms\n"
"   convmode            ascii, 7bit, iso, mac; noklusējums ascii\n"

#: common.c:709
msgid ""
" -D, --display-enc     set encoding of displayed text messages\n"
"   encoding            ansi, unicode, utf8, default to ansi\n"
msgstr ""
" -D, --display-enc     iestatīt parādīto teksta ziņojumu kodējumu\n"
"   encoding            ansi, unicode, utf8; noklusējums ansi\n"

#: common.c:712
msgid " -e, --add-eol         add a line break to the last line if there isn't one\n"
msgstr " -e, --add-eol         pievienot pēdējai rindai rindas pārnesumu, ja tā nav\n"

#: common.c:713
msgid " --error-binary        return an error when a binary file is skipped\n"
msgstr " --error-binary        atgriezt kļūdu, ja izlaists binārs fails\n"

#: common.c:714
msgid " -f, --force           force conversion of binary files\n"
msgstr " -f, --force           piespiedu kārtā pārveidot binārus failus\n"

#: common.c:717
msgid " -gb, --gb18030        convert UTF-16 to GB18030\n"
msgstr " -gb, --gb18030        pārveidot UTF-16 uz GB18030\n"

#: common.c:720
msgid " -h, --help            display this help text\n"
msgstr " -h, --help            parādīt šo palīdzības tekstu\n"

#: common.c:721
msgid ""
" -i, --info[=FLAGS]    display file information\n"
"   file ...            files to analyze\n"
msgstr ""
" -i, --info[=FLAGS]    parādīt informāciju par failu\n"
"   fails ...           analizējamie faili\n"

#: common.c:723
msgid " -k, --keepdate        keep output file date\n"
msgstr " -k, --keepdate        saglabāt izvades faila datumu\n"

#: common.c:724
msgid " -L, --license         display software license\n"
msgstr " -L, --license         parādīt programmatūras licenci\n"

#: common.c:725
msgid " -l, --newline         add additional newline\n"
msgstr " -l, --newline         pievienot papildu jaunu rindu\n"

#: common.c:726
msgid " -m, --add-bom         add Byte Order Mark (default UTF-8)\n"
msgstr " -m, --add-bom         pievienot baitu secības zīmi (noklusējums UTF-8)\n"

#: common.c:727
msgid ""
" -n, --newfile         write to new file\n"
"   infile              original file in new-file mode\n"
"   outfile             output file in new-file mode\n"
msgstr ""
" -n, --newfile         rakstīt jaunā failā\n"
"   ievades_fails       sākotnējais fails jaunā faila režīmā\n"
"   izvades_fails       izvades fails jaunā faila režīmā\n"

#: common.c:731
msgid " --no-allow-chown      don't allow file ownership change (default)\n"
msgstr " --no-allow-chown      neatļaut mainīt faila īpašnieku (noklusējums)\n"

#: common.c:733
msgid " --no-add-eol          don't add a line break to the last line if there isn't one (default)\n"
msgstr ""
" --no-add-eol          nepievienot pēdējai rindai rindas pārnesumu, ja tā nav\n"
"                       (noklusējums)\n"

#: common.c:734
msgid " --no-error-binary     don't return an error when a binary file is skipped (default)\n"
msgstr " --no-error-binary     neatgriezt kļūdu, ja izlaists binārs fails (noklusējums)\n"

#: common.c:735
msgid " -O, --to-stdout       write to standard output\n"
msgstr " -O, --to-stdout       rakstīt standarta izvadē\n"

#: common.c:736
msgid ""
" -o, --oldfile         write to old file (default)\n"
"   file ...            files to convert in old-file mode\n"
msgstr ""
" -o, --oldfile         rakstīt vecajā failā (noklusējums)\n"
"   fails ...           pārveidojamie faili vecā faila režīmā\n"

#: common.c:738
msgid " -q, --quiet           quiet mode, suppress all warnings\n"
msgstr " -q, --quiet           klusais režīms, apspiest visus brīdinājumus\n"

#: common.c:740
msgid " -r, --remove-bom      remove Byte Order Mark (default)\n"
msgstr " -r, --remove-bom      noņemt baitu secības zīmi (noklusējums)\n"

#: common.c:742
msgid " -r, --remove-bom      remove Byte Order Mark\n"
msgstr " -r, --remove-bom      noņemt baitu secības zīmi\n"

#: common.c:743
msgid " -s, --safe            skip binary files (default)\n"
msgstr " -s, --safe            izlaist binārus failus (noklusējums)\n"

#: common.c:745
msgid " -u,  --keep-utf16     keep UTF-16 encoding\n"
msgstr " -u,  --keep-utf16  saglabāt UTF-16 kodējumu\n"

#: common.c:746
msgid " -ul, --assume-utf16le assume that the input format is UTF-16LE\n"
msgstr " -ul, --assume-utf16le pieņemt, ka ievades formāts ir UTF-16LE\n"

#: common.c:747
msgid " -ub, --assume-utf16be assume that the input format is UTF-16BE\n"
msgstr " -ub, --assume-utf16be pieņemt, ka ievades formāts ir UTF-16BE\n"

#: common.c:749
msgid " -v,  --verbose        verbose operation\n"
msgstr " -v,  --verbose  detalizēta darbība\n"

#: common.c:751
msgid " -F, --follow-symlink  follow symbolic links and convert the targets\n"
msgstr " -F, --follow-symlink  sekot simboliskajām saitēm un pārveidot to mērķus\n"

#: common.c:754
msgid ""
" -R, --replace-symlink replace symbolic links with converted files\n"
"                         (original target files remain unchanged)\n"
msgstr ""
" -R, --replace-symlink aizstāt simboliskās saites ar pārveidotajiem failiem\n"
"                         (sākotnējie mērķa faili paliek nemainīti)\n"

#: common.c:756
msgid " -S, --skip-symlink    keep symbolic links and targets unchanged (default)\n"
msgstr ""
" -S, --skip-symlink    saglabāt simboliskās saites un mērķus nemainītus\n"
"                       (noklusējums)\n"

#: common.c:758
msgid " -V, --version         display version number\n"
msgstr " -V, --version         parādīt versijas numuru\n"

#: common.c:770
