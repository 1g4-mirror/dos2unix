msgstr "pārveido failu %s par failu %s Mac formātā...\n"

#: common.c:2185
#, c-format
msgid "converting file %s to Mac format...\n"
msgstr "pārveido failu %s Mac formātā...\n"

#: common.c:2188
#, c-format
