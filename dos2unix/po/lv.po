msgstr "Izlaiž UTF-16 failu %s, wchar_t izmērs ir %d baiti.\n"

#: common.c:2070 common.c:2165
#, c-format
msgid "Skipping UTF-16 file %s, an UTF-16 conversion error occurred on line %u.\n"
msgstr "Izlaiž UTF-16 failu %s, rindā %u radās UTF-16 pārveides kļūda.\n"

#: common.c:2074 common.c:2169
#, c-format
