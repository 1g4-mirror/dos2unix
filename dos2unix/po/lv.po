msgstr "Izlaiž UTF-16 failu %s, UTF-16 pārveide netiek atbalstīta šajā %s versijā.\n"

#: common.c:2140 common.c:2239
#, c-format
msgid "Skipping %s, not a regular file.\n"
msgstr "Izlaiž %s, tas nav parasts fails.\n"

#: common.c:2144
#, c-format
msgid "Skipping %s, output file %s is a symbolic link.\n"
msgstr "Izlaiž %s, izvades fails %s ir simboliskā saite.\n"

#: common.c:2146
#, c-format
msgid "Skipping symbolic link %s.\n"
msgstr "Izlaiž simbolisko saiti %s.\n"

#: common.c:2149 common.c:2244
#, c-format
msgid "Skipping symbolic link %s, target is not a regular file.\n"
msgstr "Izlaiž simbolisko saiti %s, mērķis nav parasts fails.\n"

#: common.c:2152
#, c-format
msgid "Skipping %s, target of symbolic link %s is not a regular file.\n"
msgstr "Izlaiž %s, simboliskās saites %s mērķis nav parasts fails.\n"

